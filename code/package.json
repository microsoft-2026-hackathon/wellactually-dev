{
  "name": "wellactually",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "displayName": "Wellactually",
  "publisher": "wellactually-local",
  "description": "%extension.description%",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/microsoft-2026-hackathon/wellactually.git"
  },
  "engines": {
    "vscode": "^1.137.0",
    "node": "^20.19.0 || >=22.12.0"
  },
  "main": "./dist/src/extension.cjs",
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "Other"
  ],
  "capabilities": {
    "virtualWorkspaces": false,
    "untrustedWorkspaces": {
      "supported": false,
      "description": "%trust.description%"
    }
  },
  "activationEvents": [
    "onView:wellactually.coach",
    "onCommand:wellactually.open"
  ],
  "contributes": {
    "configuration": {
      "title": "Wellactually",
      "properties": {
        "wellactually.model": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "%model.description%"
        }
      }
    },
    "commands": [
      {
        "command": "wellactually.open",
        "title": "%command.open%"
      }
    ],
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "wellactually-coach",
          "title": "%container.coach%",
          "icon": "media/coach.svg"
        }
      ]
    },
    "views": {
      "wellactually-coach": [
        {
          "type": "webview",
          "id": "wellactually.coach",
          "name": "%view.coach%"
        }
      ]
    },
    "chatAgents": [
      {
        "path": "./src/agents/driver.agent.md"
      }
    ]
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', {recursive:true, force:true})\" && tsc -p tsconfig.json",
    "vscode:prepublish": "npm run build",
    "test": "npm run build && node --test dist/test/*.test.js",
    "package": "vsce package --target darwin-arm64 --ignore-other-target-folders --skip-license --out wellactually-0.0.1.vsix"
  },
  "dependencies": {
    "@github/copilot-sdk": "1.0.13",
    "@streamparser/json": "0.0.22",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/vscode": "1.136.0",
    "@vscode/vsce": "3.9.2",
    "typescript": "6.0.3"
  }
}
